{
	Tools = ordered() {
		LL_Handle = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StyledText", Name = "Handle", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Size", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Text Color", ControlGroup = 5, },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 5, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 5, },
				Input8 = InstanceInput { SourceOp = "Pill", Source = "TopLeftRed", Name = "Pill Color", ControlGroup = 8, },
				Input9 = InstanceInput { SourceOp = "Pill", Source = "TopLeftGreen", ControlGroup = 8, },
				Input10 = InstanceInput { SourceOp = "Pill", Source = "TopLeftBlue", ControlGroup = 8, },
				Input11 = InstanceInput { SourceOp = "Dot", Source = "TopLeftRed", Name = "Icon Color", ControlGroup = 11, },
				Input12 = InstanceInput { SourceOp = "Dot", Source = "TopLeftGreen", ControlGroup = 11, },
				Input13 = InstanceInput { SourceOp = "Dot", Source = "TopLeftBlue", ControlGroup = 11, },
				Input14 = InstanceInput { SourceOp = "Title", Source = "PillWidth", },
				Input15 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input16 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input17 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input18 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "@yourname", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.03, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 0.08, },
						Green1 = Input { Value = 0.08, },
						Blue1 = Input { Value = 0.1, },
						Center = Input { Value = { 0.435, 0.5 }, Expression = "Point((0.5 - Title.PillWidth / 2) + 0.055, 0.5)", },
						HorizontalLeftCenterRight = Input { Value = -1, },
						InFrames = Input { Value = 16, },
						OutFrames = Input { Value = 12, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						PillWidth = Input { Value = 0.26, },
						PopIn = Input {
							Value = 1,
							Expression = "(1 + 2.70158 * (Title.RevealIn - 1) * (Title.RevealIn - 1) * (Title.RevealIn - 1) + 1.70158 * (Title.RevealIn - 1) * (Title.RevealIn - 1))",
						},
						PopOut = Input {
							Value = 1,
							Expression = "(1 + 2.70158 * (Title.RevealOut - 1) * (Title.RevealOut - 1) * (Title.RevealOut - 1) + 1.70158 * (Title.RevealOut - 1) * (Title.RevealOut - 1))",
						},
						Vis = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 16,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						PillWidth = {
							LINKS_Name = "Pill Width",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.05,
							INP_MaxScale = 0.8,
							INP_Default = 0.26,
							ICS_ControlPage = "Controls",
						},
						PopIn = {
							LINKS_Name = "PopIn",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						PopOut = {
							LINKS_Name = "PopOut",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				PillMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = 0, Expression = "Point((0.5 - Title.PillWidth / 2) + Title.PillWidth * Title.Ease / 2, 0.5)", },
						Width = Input { Value = 0, Expression = "Title.PillWidth * Title.Ease", },
						Height = Input { Value = 0.05, },
						CornerRadius = Input { Value = 0.5, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Pill = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "PillMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				DotMask = EllipseMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = 0, Expression = "Point((0.5 - Title.PillWidth / 2) + 0.028, 0.5)", },
						Width = Input { Value = 0, Expression = "0.034 * Title.PopIn * Title.PopOut", },
						Height = Input { Value = 0, Expression = "0.034 * Title.PopIn * Title.PopOut", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 }, },
				},
				Dot = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.96, },
						TopLeftGreen = Input { Value = 0.7, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "DotMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Pill", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "min(Title.Ease * 4, 1)", },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 66 }, },
				},
				Stack2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack1", Source = "Output", },
						Foreground = Input { SourceOp = "Dot", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 66 }, },
				},
				Stack3 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack2", Source = "Output", },
						Foreground = Input { SourceOp = "Title", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						EffectMask = Input { SourceOp = "PillMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 770, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack3", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 880, 66 }, },
				},
			},
		},
	},
	ActiveTool = "LL_Handle",
}
