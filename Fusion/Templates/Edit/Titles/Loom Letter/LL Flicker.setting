{
	Tools = ordered() {
		LL_Flicker = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StyledText", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Size", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Color", ControlGroup = 5, },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 5, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 5, },
				Input8 = InstanceInput { SourceOp = "Title", Source = "CharacterSpacing", Name = "Tracking", },
				Input9 = InstanceInput { SourceOp = "Title", Source = "Seed", },
				Input10 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input11 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input12 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input13 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "PARADOX", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.08, },
						CharacterSpacing = Input { Value = 1.4, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						InFrames = Input { Value = 20, },
						OutFrames = Input { Value = 14, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						Seed = Input { Value = 1, },
						Vis = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 20,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 14,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Seed = {
							LINKS_Name = "Random Seed",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 100,
							INP_MinAllowed = 0,
							INP_Default = 1,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				GlowBlur = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Title", Source = "Output", },
						XBlurSize = Input { Value = 12, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				GlowGain = BrightnessContrast {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "GlowBlur", Source = "Output", },
						Gain = Input { Value = 1.4, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "GlowGain", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Value = 1,
							Expression = ":local v = math.min(Title.RevealIn, Title.RevealOut)\nif v >= 1 then return 1 end\nif v <= 0 then return 0 end\nlocal n = math.sin(math.floor(time) * 12.9898 + Title.Seed * 78.233) * 43758.5453\nn = n - math.floor(n)\nif n < v then return 1 end\nreturn 0.06",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 66 }, },
				},
				Stack2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack1", Source = "Output", },
						Foreground = Input { SourceOp = "Title", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input {
							Value = 1,
							Expression = ":local v = math.min(Title.RevealIn, Title.RevealOut)\nif v >= 1 then return 1 end\nif v <= 0 then return 0 end\nlocal n = math.sin(math.floor(time) * 12.9898 + Title.Seed * 78.233) * 43758.5453\nn = n - math.floor(n)\nif n < v then return 1 end\nreturn 0.06",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 440, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack2", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 66 }, },
				},
			},
		},
	},
	ActiveTool = "LL_Flicker",
}
