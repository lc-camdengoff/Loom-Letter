{
	Tools = ordered() {
		LL_SpeedLines = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Line1", Source = "TopLeftRed", Name = "Color A", ControlGroup = 1, },
				Input2 = InstanceInput { SourceOp = "Line1", Source = "TopLeftGreen", ControlGroup = 1, },
				Input3 = InstanceInput { SourceOp = "Line1", Source = "TopLeftBlue", ControlGroup = 1, },
				Input4 = InstanceInput { SourceOp = "Line2", Source = "TopLeftRed", Name = "Color B", ControlGroup = 4, },
				Input5 = InstanceInput { SourceOp = "Line2", Source = "TopLeftGreen", ControlGroup = 4, },
				Input6 = InstanceInput { SourceOp = "Line2", Source = "TopLeftBlue", ControlGroup = 4, },
				Input7 = InstanceInput { SourceOp = "Canvas", Source = "BurstFrames", },
				Input8 = InstanceInput { SourceOp = "Canvas", Source = "Delay", },
				Input9 = InstanceInput { SourceOp = "Canvas", Source = "LineLength", },
				Input10 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input11 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input12 = InstanceInput { SourceOp = "Canvas", Source = "InFrames", },
				Input13 = InstanceInput { SourceOp = "Canvas", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
						InFrames = Input { Value = 0, },
						OutFrames = Input { Value = 0, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Canvas.InFrames, 1)) / max(Canvas.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Canvas.OutFrames, 1)) / max(Canvas.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Canvas.RevealIn) * (1 - Canvas.RevealIn) * (1 - Canvas.RevealIn)", },
						EaseOut = Input {
							Value = 1,
							Expression = "1 - (1 - Canvas.RevealOut) * (1 - Canvas.RevealOut) * (1 - Canvas.RevealOut)",
						},
						Ease = Input { Value = 1, Expression = "min(Canvas.EaseIn, Canvas.EaseOut)", },
						BurstFrames = Input { Value = 18, },
						Delay = Input { Value = 0, },
						P = Input {
							Value = 0,
							Expression = "min(max((time - comp.RenderStart - Canvas.Delay) / max(Canvas.BurstFrames, 1), 0), 1)",
						},
						E = Input { Value = 0, Expression = "1 - (1 - Canvas.P) * (1 - Canvas.P) * (1 - Canvas.P)", },
						LineLength = Input { Value = 0.18, },
						P1 = Input {
							Value = 0,
							Expression = "min(max((time - comp.RenderStart - Canvas.Delay - 0) / max(Canvas.BurstFrames, 1), 0), 1)",
						},
						P2 = Input {
							Value = 0,
							Expression = "min(max((time - comp.RenderStart - Canvas.Delay - 3) / max(Canvas.BurstFrames, 1), 0), 1)",
						},
						P3 = Input {
							Value = 0,
							Expression = "min(max((time - comp.RenderStart - Canvas.Delay - 1) / max(Canvas.BurstFrames, 1), 0), 1)",
						},
						P4 = Input {
							Value = 0,
							Expression = "min(max((time - comp.RenderStart - Canvas.Delay - 5) / max(Canvas.BurstFrames, 1), 0), 1)",
						},
						Vis = Input { Value = 1, Expression = "max(sin(Canvas.P1 * pi), sin(Canvas.P4 * pi))", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
