{
	Tools = ordered() {
		LL_TagTitle = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StyledText", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Size", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Color", ControlGroup = 5, },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 5, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 5, },
				Input8 = InstanceInput { SourceOp = "Caption", Source = "StyledText", Name = "Caption", },
				Input9 = InstanceInput { SourceOp = "Tag", Source = "TopLeftRed", Name = "Accent Color", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Tag", Source = "TopLeftGreen", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Tag", Source = "TopLeftBlue", ControlGroup = 9, },
				Input12 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input13 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input14 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input15 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "MOTION GRAPHICS", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.065, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.47 }, },
						InFrames = Input { Value = 15, },
						OutFrames = Input { Value = 12, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						Vis = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 15,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				Caption = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "WITHOUT HASSLE", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.02, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 0.08, },
						Green1 = Input { Value = 0.08, },
						Blue1 = Input { Value = 0.1, },
						Center = Input { Value = { 0.5, 0.56 }, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				TagMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.56 }, },
						Width = Input { Value = 0.15, },
						Height = Input { Value = 0.022, },
						CornerRadius = Input { Value = 0.2, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				Tag = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.96, },
						TopLeftGreen = Input { Value = 0.7, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "TagMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 }, },
				},
				TagMove = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Tag", Source = "Output", },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5, 0.5 + (1 - Title.EaseIn) * 0.05 - (1 - Title.EaseOut) * 0.05)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 }, },
				},
				CaptionMove = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Caption", Source = "Output", },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5, 0.5 + (1 - Title.EaseIn) * 0.05 - (1 - Title.EaseOut) * 0.05)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 }, },
				},
				TitleMove = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Title", Source = "Output", },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5, 0.5 - (1 - Title.EaseIn) * 0.05 + (1 - Title.EaseOut) * 0.05)",
						},
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 5, },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "TagMove", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 770, 66 }, },
				},
				Stack2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack1", Source = "Output", },
						Foreground = Input { SourceOp = "CaptionMove", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 880, 66 }, },
				},
				Stack3 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack2", Source = "Output", },
						Foreground = Input { SourceOp = "TitleMove", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 990, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack3", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 1100, 66 }, },
				},
			},
		},
	},
	ActiveTool = "LL_TagTitle",
}
