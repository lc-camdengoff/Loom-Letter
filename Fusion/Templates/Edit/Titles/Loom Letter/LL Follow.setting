{
	Tools = ordered() {
		LL_Follow = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "ButtonText", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "ClickedText", },
				Input3 = InstanceInput { SourceOp = "Title", Source = "ClickFrame", },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 4, },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 4, },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Size", Name = "Text Size", },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Text Color", ControlGroup = 7, },
				Input8 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 7, },
				Input9 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 7, },
				Input10 = InstanceInput { SourceOp = "Button", Source = "TopLeftRed", Name = "Button Color", ControlGroup = 10, },
				Input11 = InstanceInput { SourceOp = "Button", Source = "TopLeftGreen", ControlGroup = 10, },
				Input12 = InstanceInput { SourceOp = "Button", Source = "TopLeftBlue", ControlGroup = 10, },
				Input13 = InstanceInput { SourceOp = "Pressed", Source = "TopLeftRed", Name = "Clicked Color", ControlGroup = 13, },
				Input14 = InstanceInput { SourceOp = "Pressed", Source = "TopLeftGreen", ControlGroup = 13, },
				Input15 = InstanceInput { SourceOp = "Pressed", Source = "TopLeftBlue", ControlGroup = 13, },
				Input16 = InstanceInput { SourceOp = "Title", Source = "BtnWidth", },
				Input17 = InstanceInput { SourceOp = "Title", Source = "BtnHeight", },
				Input18 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input19 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input20 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input21 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Value = "",
							Expression = ":local start = 0\nif comp then start = comp.RenderStart end\nif time - start >= Title.ClickFrame then return tostring(Title.ClickedText.Value or \"\") end\nreturn tostring(Title.ButtonText.Value or \"\")",
						},
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.032, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						InFrames = Input { Value = 12, },
						OutFrames = Input { Value = 10, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						ButtonText = Input { Value = "+  FOLLOW", },
						ClickedText = Input { Value = "FOLLOWING", },
						ClickFrame = Input { Value = 30, },
						BtnWidth = Input { Value = 0.2, },
						BtnHeight = Input { Value = 0.055, },
						Clicked = Input { Value = 0, Expression = "min(max((time - comp.RenderStart - Title.ClickFrame) / 3, 0), 1)", },
						Dip = Input { Value = 1, Expression = "1 - 0.08 * max(0, 1 - abs(time - comp.RenderStart - Title.ClickFrame) / 4)", },
						PopIn = Input {
							Value = 1,
							Expression = "(1 + 2.70158 * (Title.RevealIn - 1) * (Title.RevealIn - 1) * (Title.RevealIn - 1) + 1.70158 * (Title.RevealIn - 1) * (Title.RevealIn - 1))",
						},
						PopOut = Input {
							Value = 1,
							Expression = "(1 + 2.70158 * (Title.RevealOut - 1) * (Title.RevealOut - 1) * (Title.RevealOut - 1) + 1.70158 * (Title.RevealOut - 1) * (Title.RevealOut - 1))",
						},
						Vis = Input { Value = 1, Expression = "max(Title.PopIn * Title.PopOut, 0)", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 10,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						ButtonText = {
							LINKS_Name = "Button Text",
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 1,
							ICS_ControlPage = "Controls",
						},
						ClickedText = {
							LINKS_Name = "Clicked Text",
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 1,
							ICS_ControlPage = "Controls",
						},
						ClickFrame = {
							LINKS_Name = "Click at Frame",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 240,
							INP_MinAllowed = 0,
							INP_Default = 30,
							ICS_ControlPage = "Controls",
						},
						BtnWidth = {
							LINKS_Name = "Button Width",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.05,
							INP_MaxScale = 0.6,
							INP_Default = 0.2,
							ICS_ControlPage = "Controls",
						},
						BtnHeight = {
							LINKS_Name = "Button Height",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.02,
							INP_MaxScale = 0.2,
							INP_Default = 0.055,
							ICS_ControlPage = "Controls",
						},
						Clicked = {
							LINKS_Name = "Clicked",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 0,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Dip = {
							LINKS_Name = "Dip",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						PopIn = {
							LINKS_Name = "PopIn",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						PopOut = {
							LINKS_Name = "PopOut",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				BtnMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0, Expression = "Title.BtnWidth", },
						Height = Input { Value = 0, Expression = "Title.BtnHeight", },
						CornerRadius = Input { Value = 0.5, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Button = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.1, },
						TopLeftGreen = Input { Value = 0.55, },
						TopLeftBlue = Input { Value = 0.98, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "BtnMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				Pressed = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.3, },
						TopLeftGreen = Input { Value = 0.3, },
						TopLeftBlue = Input { Value = 0.34, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "BtnMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Button", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 66 }, },
				},
				Stack2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack1", Source = "Output", },
						Foreground = Input { SourceOp = "Pressed", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Clicked", },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 66 }, },
				},
				Stack3 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack2", Source = "Output", },
						Foreground = Input { SourceOp = "Title", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Bounce", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 1010, 132 }, },
				},
				Bounce = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack3", Source = "Output", },
						Size = Input { Value = 1, Expression = "max(Title.PopIn * Title.PopOut, 0) * Title.Dip", },
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 5, },
					},
					ViewInfo = OperatorInfo { Pos = { 900, 132 }, },
				},
			},
		},
	},
	ActiveTool = "LL_Follow",
}
