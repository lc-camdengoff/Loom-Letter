{
	Tools = ordered() {
		LL_LowerThird = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "NameText", Source = "StyledText", Name = "Name", },
				Input2 = InstanceInput { SourceOp = "RoleText", Source = "StyledText", Name = "Role", },
				Input3 = InstanceInput { SourceOp = "NameText", Source = "Font", Name = "Name Font", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "NameText", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "RoleText", Source = "Font", Name = "Role Font", ControlGroup = 5, },
				Input6 = InstanceInput { SourceOp = "RoleText", Source = "Style", ControlGroup = 5, },
				Input7 = InstanceInput { SourceOp = "NameText", Source = "Size", Name = "Name Size", },
				Input8 = InstanceInput { SourceOp = "RoleText", Source = "Size", Name = "Role Size", },
				Input9 = InstanceInput { SourceOp = "NameText", Source = "Red1", Name = "Name Color", ControlGroup = 9, Default = 1, },
				Input10 = InstanceInput { SourceOp = "NameText", Source = "Green1", ControlGroup = 9, Default = 1, },
				Input11 = InstanceInput { SourceOp = "NameText", Source = "Blue1", ControlGroup = 9, Default = 1, },
				Input12 = InstanceInput { SourceOp = "RoleText", Source = "Red1", Name = "Role Color", ControlGroup = 12, Default = 0.85, },
				Input13 = InstanceInput { SourceOp = "RoleText", Source = "Green1", ControlGroup = 12, Default = 0.85, },
				Input14 = InstanceInput { SourceOp = "RoleText", Source = "Blue1", ControlGroup = 12, Default = 0.85, },
				Input15 = InstanceInput { SourceOp = "Accent", Source = "TopLeftRed", Name = "Accent Color", ControlGroup = 15, Default = 0.96, },
				Input16 = InstanceInput { SourceOp = "Accent", Source = "TopLeftGreen", ControlGroup = 15, Default = 0.7, },
				Input17 = InstanceInput { SourceOp = "Accent", Source = "TopLeftBlue", ControlGroup = 15, Default = 0, },
				Input18 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input19 = InstanceInput { SourceOp = "NameText", Source = "InFrames", Default = 18, },
				Input20 = InstanceInput { SourceOp = "NameText", Source = "OutFrames", Default = 12, },
				Input21 = InstanceInput { SourceOp = "NameText", Source = "Slide", Default = 0.1, },
				Input22 = InstanceInput { SourceOp = "NameText", Source = "BarHeight", Default = 0.09, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				NameText = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "JANE DOE", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.045, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.105, 0.225 }, },
						HorizontalLeftCenterRight = Input { Value = -1, },
						InFrames = Input { Value = 18, },
						OutFrames = Input { Value = 12, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(NameText.InFrames, 1)) / max(NameText.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(NameText.OutFrames, 1)) / max(NameText.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input {
							Value = 1,
							Expression = "1 - (1 - NameText.RevealIn) * (1 - NameText.RevealIn) * (1 - NameText.RevealIn)",
						},
						EaseOut = Input {
							Value = 1,
							Expression = "1 - (1 - NameText.RevealOut) * (1 - NameText.RevealOut) * (1 - NameText.RevealOut)",
						},
						Ease = Input { Value = 1, Expression = "min(NameText.EaseIn, NameText.EaseOut)", },
						Slide = Input { Value = 0.1, },
						BarHeight = Input { Value = 0.09, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 18,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Slide = {
							LINKS_Name = "Slide Distance",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 0.3,
							INP_Default = 0.1,
							ICS_ControlPage = "Controls",
						},
						BarHeight = {
							LINKS_Name = "Bar Height",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 0.3,
							INP_Default = 0.09,
							ICS_ControlPage = "Controls",
						},
					},
				},
				RoleText = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "Title / Role", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.03, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 0.85, },
						Green1 = Input { Value = 0.85, },
						Blue1 = Input { Value = 0.85, },
						Center = Input { Value = { 0.105, 0.175 }, },
						HorizontalLeftCenterRight = Input { Value = -1, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 49.5 }, },
				},
				NameMove = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 - (1 - NameText.EaseIn) * NameText.Slide + (1 - NameText.EaseOut) * NameText.Slide, 0.5)",
						},
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 5, },
						Input = Input { SourceOp = "NameText", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				RoleMove = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 - (1 - NameText.EaseIn) * NameText.Slide + (1 - NameText.EaseOut) * NameText.Slide, 0.5)",
						},
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 5, },
						Input = Input { SourceOp = "RoleText", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 49.5 }, },
				},
				BarMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.09, 0.2 }, },
						Width = Input { Value = 0.005, },
						Height = Input { Value = 0.09, Expression = "NameText.Ease * NameText.BarHeight", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -99 }, },
				},
				RevealMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.593, 0.2 }, },
						Width = Input { Value = 1, },
						Height = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, -99 }, },
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -148.5 }, },
				},
				Accent = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.96, },
						TopLeftGreen = Input { Value = 0.7, },
						TopLeftBlue = Input { Value = 0, },
						EffectMask = Input { SourceOp = "BarMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -49.5 }, },
				},
				BarOver = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Accent", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, -49.5 }, },
				},
				NameOver = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "BarOver", Source = "Output", },
						Foreground = Input { SourceOp = "NameMove", Source = "Output", },
						Blend = Input { Value = 1, Expression = "NameText.Ease", },
						EffectMask = Input { SourceOp = "RevealMask", Source = "Mask", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 }, },
				},
				RoleOver = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "NameOver", Source = "Output", },
						Foreground = Input { SourceOp = "RoleMove", Source = "Output", },
						Blend = Input { Value = 1, Expression = "NameText.Ease", },
						EffectMask = Input { SourceOp = "RevealMask", Source = "Mask", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "RoleOver", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 }, },
				},
			},
		},
	},
	ActiveTool = "LL_LowerThird",
}
