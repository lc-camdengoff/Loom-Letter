{
	Tools = ordered() {
		LL_RingBurst = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Ring", Source = "TopLeftRed", Name = "Color", ControlGroup = 1, },
				Input2 = InstanceInput { SourceOp = "Ring", Source = "TopLeftGreen", ControlGroup = 1, },
				Input3 = InstanceInput { SourceOp = "Ring", Source = "TopLeftBlue", ControlGroup = 1, },
				Input4 = InstanceInput { SourceOp = "Canvas", Source = "BurstFrames", },
				Input5 = InstanceInput { SourceOp = "Canvas", Source = "Delay", },
				Input6 = InstanceInput { SourceOp = "Canvas", Source = "RingSize", },
				Input7 = InstanceInput { SourceOp = "Canvas", Source = "Thickness", },
				Input8 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input9 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input10 = InstanceInput { SourceOp = "Canvas", Source = "InFrames", },
				Input11 = InstanceInput { SourceOp = "Canvas", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
						InFrames = Input { Value = 0, },
						OutFrames = Input { Value = 0, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Canvas.InFrames, 1)) / max(Canvas.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Canvas.OutFrames, 1)) / max(Canvas.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Canvas.RevealIn) * (1 - Canvas.RevealIn) * (1 - Canvas.RevealIn)", },
						EaseOut = Input {
							Value = 1,
							Expression = "1 - (1 - Canvas.RevealOut) * (1 - Canvas.RevealOut) * (1 - Canvas.RevealOut)",
						},
						Ease = Input { Value = 1, Expression = "min(Canvas.EaseIn, Canvas.EaseOut)", },
						BurstFrames = Input { Value = 24, },
						Delay = Input { Value = 0, },
						P = Input {
							Value = 0,
							Expression = "min(max((time - comp.RenderStart - Canvas.Delay) / max(Canvas.BurstFrames, 1), 0), 1)",
						},
						E = Input { Value = 0, Expression = "1 - (1 - Canvas.P) * (1 - Canvas.P) * (1 - Canvas.P)", },
						RingSize = Input { Value = 0.3, },
						Thickness = Input { Value = 0.02, },
						Vis = Input { Value = 1, Expression = "min(Canvas.P * 8, 1) * (1 - Canvas.P * Canvas.P)", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						BurstFrames = {
							LINKS_Name = "Burst Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 1,
							INP_MaxScale = 90,
							INP_MinAllowed = 0,
							INP_Default = 24,
							ICS_ControlPage = "Controls",
						},
						Delay = {
							LINKS_Name = "Delay Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						P = {
							LINKS_Name = "P",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 0,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						E = {
							LINKS_Name = "E",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 0,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RingSize = {
							LINKS_Name = "Ring Size",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 0.3,
							ICS_ControlPage = "Controls",
						},
						Thickness = {
							LINKS_Name = "Thickness",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 0.1,
							INP_Default = 0.02,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				RingMask = EllipseMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0, Expression = "Canvas.RingSize * Canvas.E", },
						Height = Input { Value = 0, Expression = "Canvas.RingSize * Canvas.E", },
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0, Expression = "Canvas.Thickness * (1 - Canvas.P)", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Ring = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "RingMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Ring", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "min(Canvas.P * 8, 1) * (1 - Canvas.P * Canvas.P)", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack1", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 66 }, },
				},
			},
		},
	},
	ActiveTool = "LL_RingBurst",
}
