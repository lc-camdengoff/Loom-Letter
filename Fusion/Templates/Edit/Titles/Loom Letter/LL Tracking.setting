{
	Tools = ordered() {
		LL_Tracking = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StyledText", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Size", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Color", ControlGroup = 5, Default = 1, },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 5, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 5, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Title", Source = "Center", Name = "Position", },
				Input9 = InstanceInput { SourceOp = "Title", Source = "Tracking", Default = 1.25, },
				Input10 = InstanceInput { SourceOp = "Title", Source = "Spread", Default = 0.6, },
				Input11 = InstanceInput { SourceOp = "Title", Source = "InFrames", Default = 30, },
				Input12 = InstanceInput { SourceOp = "Title", Source = "OutFrames", Default = 15, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Fade", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "CINEMATIC", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.075, },
						CharacterSpacing = Input { Value = 1.25, Expression = "Title.Tracking + (1 - Title.Ease) * Title.Spread", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						InFrames = Input { Value = 30, },
						OutFrames = Input { Value = 15, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						Tracking = Input { Value = 1.25, },
						Spread = Input { Value = 0.6, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 30,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 15,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Tracking = {
							LINKS_Name = "Final Tracking",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.8,
							INP_MaxScale = 2,
							INP_Default = 1.25,
							ICS_ControlPage = "Controls",
						},
						Spread = {
							LINKS_Name = "Tracking Spread",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_Default = 0.6,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Soften = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						XBlurSize = Input { Value = 0, Expression = "(1 - Title.Ease) * 6", },
						Input = Input { SourceOp = "Title", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, -49.5 }, },
				},
				Fade = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Soften", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
			},
		},
	},
	ActiveTool = "LL_Tracking",
}
