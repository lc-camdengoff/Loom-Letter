{
	Tools = ordered() {
		LL_BlurIn = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StyledText", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Size", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "CharacterSpacing", Name = "Tracking", },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Color", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 6, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Title", Source = "Center", Name = "Position", },
				Input10 = InstanceInput { SourceOp = "Title", Source = "InFrames", Default = 18, },
				Input11 = InstanceInput { SourceOp = "Title", Source = "OutFrames", Default = 12, },
				Input12 = InstanceInput { SourceOp = "Title", Source = "BlurAmount", Default = 12, },
				Input13 = InstanceInput { SourceOp = "Title", Source = "ScaleAmount", Default = 0.12, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Fade", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "YOUR TITLE HERE", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.08, },
						CharacterSpacing = Input { Value = 1.05, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						InFrames = Input { Value = 18, },
						OutFrames = Input { Value = 12, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						BlurAmount = Input { Value = 12, },
						ScaleAmount = Input { Value = 0.12, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 18,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						BlurAmount = {
							LINKS_Name = "Blur Amount",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 40,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						ScaleAmount = {
							LINKS_Name = "Scale Amount",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_Default = 0.12,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Soften = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						XBlurSize = Input { Value = 0, Expression = "(1 - Title.Ease) * Title.BlurAmount", },
						Input = Input { SourceOp = "Title", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Scale = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(Title.Center.X, Title.Center.Y)", },
						Pivot = Input { Value = { 0.5, 0.5 }, Expression = "Point(Title.Center.X, Title.Center.Y)", },
						Size = Input { Value = 1, Expression = "1 + (1 - Title.Ease) * Title.ScaleAmount", },
						Input = Input { SourceOp = "Soften", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, -49.5 }, },
				},
				Fade = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Scale", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 }, },
				},
			},
		},
	},
	ActiveTool = "LL_BlurIn",
}
