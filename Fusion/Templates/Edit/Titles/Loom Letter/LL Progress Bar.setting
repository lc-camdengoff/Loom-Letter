{
	Tools = ordered() {
		LL_ProgressBar = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "Percent", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "CountFrames", },
				Input3 = InstanceInput { SourceOp = "Title", Source = "StyledText", Name = "Label", },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 4, },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 4, },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Text Color", ControlGroup = 6, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 6, },
				Input8 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 6, },
				Input9 = InstanceInput { SourceOp = "Fill", Source = "TopLeftRed", Name = "Bar Color", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Fill", Source = "TopLeftGreen", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Fill", Source = "TopLeftBlue", ControlGroup = 9, },
				Input12 = InstanceInput { SourceOp = "Track", Source = "TopLeftRed", Name = "Track Color", ControlGroup = 12, },
				Input13 = InstanceInput { SourceOp = "Track", Source = "TopLeftGreen", ControlGroup = 12, },
				Input14 = InstanceInput { SourceOp = "Track", Source = "TopLeftBlue", ControlGroup = 12, },
				Input15 = InstanceInput { SourceOp = "Title", Source = "BarWidth", },
				Input16 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input17 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input18 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input19 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "1980 VOTES", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.028, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.25, 0.54 }, Expression = "Point(0.5 - Title.BarWidth / 2, 0.54)", },
						HorizontalLeftCenterRight = Input { Value = -1, },
						InFrames = Input { Value = 12, },
						OutFrames = Input { Value = 12, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						BarWidth = Input { Value = 0.5, },
						Percent = Input { Value = 80, },
						CountFrames = Input { Value = 40, },
						CountP = Input { Value = 0, Expression = "min(max((time - comp.RenderStart) / max(Title.CountFrames, 1), 0), 1)", },
						Count = Input { Value = 0, Expression = "1 - (1 - Title.CountP) * (1 - Title.CountP) * (1 - Title.CountP)", },
						Vis = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						BarWidth = {
							LINKS_Name = "Bar Width",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.05,
							INP_MaxScale = 0.9,
							INP_Default = 0.5,
							ICS_ControlPage = "Controls",
						},
						Percent = {
							LINKS_Name = "Percent",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 100,
							INP_Default = 80,
							ICS_ControlPage = "Controls",
						},
						CountFrames = {
							LINKS_Name = "Count Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 1,
							INP_MaxScale = 240,
							INP_MinAllowed = 0,
							INP_Default = 40,
							ICS_ControlPage = "Controls",
						},
						CountP = {
							LINKS_Name = "CountP",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 0,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Count = {
							LINKS_Name = "Count",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 0,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				PercentText = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Value = "",
							Expression = ":local v = Title.Percent * Title.Count\nreturn string.format(\"%d%%\", math.floor(v + 0.5))",
						},
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.028, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.75, 0.54 }, Expression = "Point(0.5 + Title.BarWidth / 2, 0.54)", },
						HorizontalLeftCenterRight = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				TrackMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.48 }, },
						Width = Input { Value = 0, Expression = "Title.BarWidth", },
						Height = Input { Value = 0.018, },
						CornerRadius = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				Track = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.3, },
						TopLeftGreen = Input { Value = 0.3, },
						TopLeftBlue = Input { Value = 0.34, },
						TopLeftAlpha = Input { Value = 0.8, },
						EffectMask = Input { SourceOp = "TrackMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 }, },
				},
				Fill = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.96, },
						TopLeftGreen = Input { Value = 0.7, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "TrackMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 }, },
				},
				FillMove = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Fill", Source = "Output", },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 - Title.BarWidth * (1 - Title.Percent / 100 * Title.Count), 0.5)",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Track", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 66 }, },
				},
				Stack2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack1", Source = "Output", },
						Foreground = Input { SourceOp = "FillMove", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
						EffectMask = Input { SourceOp = "TrackMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 770, 66 }, },
				},
				Stack3 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack2", Source = "Output", },
						Foreground = Input { SourceOp = "Title", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 880, 66 }, },
				},
				Stack4 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack3", Source = "Output", },
						Foreground = Input { SourceOp = "PercentText", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 990, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack4", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 1100, 66 }, },
				},
			},
		},
	},
	ActiveTool = "LL_ProgressBar",
}
