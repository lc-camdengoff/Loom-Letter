{
	Tools = ordered() {
		LL_Credits = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StyledText", Name = "Name", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "Font", Name = "Name Font", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Size", Name = "Name Size", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Name Color", ControlGroup = 5, },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 5, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 5, },
				Input8 = InstanceInput { SourceOp = "Credit", Source = "StyledText", Name = "Credit Line", },
				Input9 = InstanceInput { SourceOp = "Credit", Source = "Red1", Name = "Credit Color", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Credit", Source = "Green1", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Credit", Source = "Blue1", ControlGroup = 9, },
				Input12 = InstanceInput { SourceOp = "Title", Source = "Tracking", },
				Input13 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input14 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input15 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input16 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "Mister Horse", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.065, },
						CharacterSpacing = Input { Value = 1.05, Expression = "Title.Tracking + (1 - Title.Ease) * 0.2", },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.47 }, },
						InFrames = Input { Value = 30, },
						OutFrames = Input { Value = 24, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						Tracking = Input { Value = 1.05, },
						Vis = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 30,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 24,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Tracking = {
							LINKS_Name = "Final Tracking",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.8,
							INP_MaxScale = 2,
							INP_Default = 1.05,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				Credit = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "Created by", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.024, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 0.8, },
						Green1 = Input { Value = 0.8, },
						Blue1 = Input { Value = 0.8, },
						Center = Input { Value = { 0.5, 0.54 }, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Soften = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Title", Source = "Output", },
						XBlurSize = Input { Value = 0, Expression = "(1 - Title.Ease) * 5", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Credit", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.EaseIn * Title.EaseOut", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 66 }, },
				},
				Stack2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack1", Source = "Output", },
						Foreground = Input { SourceOp = "Soften", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Drift", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 1010, 132 }, },
				},
				Drift = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack2", Source = "Output", },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5, 0.5 + 0.012 * (time - comp.RenderStart) / max(comp.RenderEnd - comp.RenderStart, 1))",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 900, 132 }, },
				},
			},
		},
	},
	ActiveTool = "LL_Credits",
}
