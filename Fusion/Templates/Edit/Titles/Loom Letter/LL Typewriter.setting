{
	Tools = ordered() {
		LL_Typewriter = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "Message", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Size", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "CharacterSpacing", Name = "Tracking", },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Color", ControlGroup = 6, Default = 1, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 6, Default = 1, },
				Input8 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 6, Default = 1, },
				Input9 = InstanceInput { SourceOp = "Title", Source = "Center", Name = "Position", },
				Input10 = InstanceInput { SourceOp = "Title", Source = "Speed", Default = 0.6, },
				Input11 = InstanceInput { SourceOp = "Title", Source = "Cursor", Default = 1, },
				Input12 = InstanceInput { SourceOp = "Title", Source = "OutFrames", Default = 10, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Fade", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Value = "",
							Expression = ":local s = tostring(Title.Message.Value or \"\")\nlocal start = 0\nif comp then start = comp.RenderStart end\nlocal chars = {}\nfor ch in s:gmatch(\"[%z\\1-\\127\\194-\\244][\\128-\\191]*\") do chars[#chars + 1] = ch end\nlocal n = math.floor((time - start) * Title.Speed + 0.0001)\nif n < 0 then n = 0 end\nif n > #chars then n = #chars end\nlocal out = table.concat(chars, \"\", 1, n)\nif Title.Cursor > 0.5 and (n < #chars or math.floor(time / 8) % 2 == 0) then out = out .. \"_\" end\nreturn out",
						},
						Font = Input { Value = "Courier New", },
						Style = Input { Value = "Regular", },
						Size = Input { Value = 0.06, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.2, 0.5 }, },
						HorizontalLeftCenterRight = Input { Value = -1, },
						InFrames = Input { Value = 0, },
						OutFrames = Input { Value = 10, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						Message = Input { Value = "Type your message here", },
						Speed = Input { Value = 0.6, },
						Cursor = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						Message = {
							LINKS_Name = "Message",
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 3,
							ICS_ControlPage = "Controls",
						},
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 10,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Speed = {
							LINKS_Name = "Typing Speed (chars/frame)",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.05,
							INP_MaxScale = 3,
							INP_Default = 0.6,
							ICS_ControlPage = "Controls",
						},
						Cursor = {
							LINKS_Name = "Show Cursor",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							INP_Default = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, -49.5 }, },
				},
				Fade = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Title", Source = "Output", },
						Blend = Input { Value = 1, Expression = "Title.EaseOut", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
			},
		},
	},
	ActiveTool = "LL_Typewriter",
}
