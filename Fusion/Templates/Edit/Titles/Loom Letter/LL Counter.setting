{
	Tools = ordered() {
		LL_Counter = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StartValue", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "EndValue", },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Decimals", },
				Input4 = InstanceInput { SourceOp = "Title", Source = "CountFrames", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "CountDelay", },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Separator", },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Prefix", },
				Input8 = InstanceInput { SourceOp = "Title", Source = "Suffix", },
				Input9 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Title", Source = "Size", },
				Input12 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Color", ControlGroup = 12, },
				Input13 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 12, },
				Input14 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 12, },
				Input15 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input16 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input17 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input18 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Value = "",
							Expression = ":local start = 0\nif comp then start = comp.RenderStart end\nlocal p = (time - start - Title.CountDelay) / math.max(Title.CountFrames, 1)\nif p < 0 then p = 0 elseif p > 1 then p = 1 end\np = 1 - (1 - p) ^ 3\nlocal v = Title.StartValue + (Title.EndValue - Title.StartValue) * p\nlocal d = math.floor(Title.Decimals + 0.5)\nlocal s = string.format(\"%.\" .. d .. \"f\", math.abs(v))\nif Title.Separator > 0.5 then\n  local int, frac = s:match(\"^(%d+)(.*)$\")\n  int = int:reverse():gsub(\"(%d%d%d)\", \"%1,\"):reverse()\n  if int:sub(1, 1) == \",\" then int = int:sub(2) end\n  s = int .. frac\nend\nif v < 0 then s = \"-\" .. s end\nreturn tostring(Title.Prefix.Value or \"\") .. s .. tostring(Title.Suffix.Value or \"\")",
						},
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.09, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						InFrames = Input { Value = 10, },
						OutFrames = Input { Value = 10, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						StartValue = Input { Value = 0, },
						EndValue = Input { Value = 38458, },
						Decimals = Input { Value = 0, },
						CountFrames = Input { Value = 45, },
						CountDelay = Input { Value = 0, },
						Separator = Input { Value = 1, },
						Prefix = Input { Value = "$", },
						Suffix = Input { Value = "", },
						Vis = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 10,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 10,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						StartValue = {
							LINKS_Name = "Start Value",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 100000,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						EndValue = {
							LINKS_Name = "End Value",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 100000,
							INP_Default = 38458,
							ICS_ControlPage = "Controls",
						},
						Decimals = {
							LINKS_Name = "Decimals",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 4,
							INP_MinAllowed = 0,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						CountFrames = {
							LINKS_Name = "Count Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 1,
							INP_MaxScale = 240,
							INP_MinAllowed = 0,
							INP_Default = 45,
							ICS_ControlPage = "Controls",
						},
						CountDelay = {
							LINKS_Name = "Count Delay",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 120,
							INP_MinAllowed = 0,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						Separator = {
							LINKS_Name = "Thousands Separator",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							INP_Default = 1,
							ICS_ControlPage = "Controls",
						},
						Prefix = {
							LINKS_Name = "Prefix",
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 1,
							ICS_ControlPage = "Controls",
						},
						Suffix = {
							LINKS_Name = "Suffix",
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 1,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				Rise = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Title", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(0.5, 0.5 - (1 - Title.EaseIn) * 0.03)", },
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 5, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Rise", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack1", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 66 }, },
				},
			},
		},
	},
	ActiveTool = "LL_Counter",
}
