{
	Tools = ordered() {
		LL_SplitWord = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StyledText", Name = "Left", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "Font", Name = "Left Font", ControlGroup = 2, },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 2, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Size", Name = "Left Size", },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Left Color", ControlGroup = 5, },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 5, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 5, },
				Input8 = InstanceInput { SourceOp = "Right", Source = "StyledText", Name = "Right", },
				Input9 = InstanceInput { SourceOp = "Right", Source = "Font", Name = "Right Font", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Right", Source = "Style", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Right", Source = "Size", Name = "Right Size", },
				Input12 = InstanceInput { SourceOp = "Right", Source = "Red1", Name = "Right Color", ControlGroup = 12, },
				Input13 = InstanceInput { SourceOp = "Right", Source = "Green1", ControlGroup = 12, },
				Input14 = InstanceInput { SourceOp = "Right", Source = "Blue1", ControlGroup = 12, },
				Input15 = InstanceInput { SourceOp = "Bar", Source = "TopLeftRed", Name = "Divider Color", ControlGroup = 15, },
				Input16 = InstanceInput { SourceOp = "Bar", Source = "TopLeftGreen", ControlGroup = 15, },
				Input17 = InstanceInput { SourceOp = "Bar", Source = "TopLeftBlue", ControlGroup = 15, },
				Input18 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input19 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input20 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input21 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "MISTER", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.07, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 0.96, },
						Green1 = Input { Value = 0.7, },
						Blue1 = Input { Value = 0, },
						Center = Input { Value = { 0.49, 0.5 }, },
						HorizontalLeftCenterRight = Input { Value = 1, },
						InFrames = Input { Value = 18, },
						OutFrames = Input { Value = 12, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						Vis = Input { Value = 1, Expression = "Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 18,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 12,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				Right = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input { Value = "HORSE", },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.07, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.51, 0.5 }, },
						HorizontalLeftCenterRight = Input { Value = -1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Divider = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0.003, },
						Height = Input { Value = 0, Expression = "0.06 * Title.Ease", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				Bar = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 1, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "Divider", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 }, },
				},
				LeftClip = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.249, 0.5 }, },
						Width = Input { Value = 0.5, },
						Height = Input { Value = 2, },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 }, },
				},
				RightClip = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.751, 0.5 }, },
						Width = Input { Value = 0.5, },
						Height = Input { Value = 2, },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 }, },
				},
				LeftMove = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Title", Source = "Output", },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 + ((1 - Title.EaseIn) + (1 - Title.EaseOut)) * 0.12, 0.5)",
						},
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 5, },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 }, },
				},
				RightMove = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Right", Source = "Output", },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 - ((1 - Title.EaseIn) + (1 - Title.EaseOut)) * 0.12, 0.5)",
						},
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 5, },
					},
					ViewInfo = OperatorInfo { Pos = { 770, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Bar", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 880, 66 }, },
				},
				Stack2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack1", Source = "Output", },
						Foreground = Input { SourceOp = "LeftMove", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
						EffectMask = Input { SourceOp = "LeftClip", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 990, 66 }, },
				},
				Stack3 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack2", Source = "Output", },
						Foreground = Input { SourceOp = "RightMove", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
						Blend = Input { Value = 1, Expression = "Title.Ease", },
						EffectMask = Input { SourceOp = "RightClip", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 1100, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack3", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 1210, 66 }, },
				},
			},
		},
	},
	ActiveTool = "LL_SplitWord",
}
