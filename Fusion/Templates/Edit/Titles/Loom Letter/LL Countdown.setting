{
	Tools = ordered() {
		LL_Countdown = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Title", Source = "StartSeconds", },
				Input2 = InstanceInput { SourceOp = "Title", Source = "FPS", },
				Input3 = InstanceInput { SourceOp = "Title", Source = "Font", ControlGroup = 3, },
				Input4 = InstanceInput { SourceOp = "Title", Source = "Style", ControlGroup = 3, },
				Input5 = InstanceInput { SourceOp = "Title", Source = "Size", },
				Input6 = InstanceInput { SourceOp = "Title", Source = "Red1", Name = "Text Color", ControlGroup = 6, },
				Input7 = InstanceInput { SourceOp = "Title", Source = "Green1", ControlGroup = 6, },
				Input8 = InstanceInput { SourceOp = "Title", Source = "Blue1", ControlGroup = 6, },
				Input9 = InstanceInput { SourceOp = "Box", Source = "TopLeftRed", Name = "Box Color", ControlGroup = 9, },
				Input10 = InstanceInput { SourceOp = "Box", Source = "TopLeftGreen", ControlGroup = 9, },
				Input11 = InstanceInput { SourceOp = "Box", Source = "TopLeftBlue", ControlGroup = 9, },
				Input12 = InstanceInput { SourceOp = "Bar", Source = "TopLeftRed", Name = "Accent Color", ControlGroup = 12, },
				Input13 = InstanceInput { SourceOp = "Bar", Source = "TopLeftGreen", ControlGroup = 12, },
				Input14 = InstanceInput { SourceOp = "Bar", Source = "TopLeftBlue", ControlGroup = 12, },
				Input15 = InstanceInput { SourceOp = "Place", Source = "Center", Name = "Position", },
				Input16 = InstanceInput { SourceOp = "Place", Source = "Size", Name = "Scale", Default = 1, },
				Input17 = InstanceInput { SourceOp = "Title", Source = "InFrames", },
				Input18 = InstanceInput { SourceOp = "Title", Source = "OutFrames", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Place", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 }, },
			Tools = ordered() {
				Title = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						StyledText = Input {
							Value = "",
							Expression = ":local start = 0\nif comp then start = comp.RenderStart end\nlocal remain = Title.StartSeconds - (time - start) / math.max(Title.FPS, 1)\nif remain < 0 then remain = 0 end\nlocal secs = math.ceil(remain - 0.000001)\nreturn string.format(\"%02d:%02d\", math.floor(secs / 60), secs % 60)",
						},
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.06, },
						CharacterSpacing = Input { Value = 1, },
						Red1 = Input { Value = 1, },
						Green1 = Input { Value = 1, },
						Blue1 = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.51 }, },
						InFrames = Input { Value = 10, },
						OutFrames = Input { Value = 10, },
						RevealIn = Input {
							Value = 1,
							Expression = "min(max((time - comp.RenderStart + 1 - min(Title.InFrames, 1)) / max(Title.InFrames, 1), 0), 1)",
						},
						RevealOut = Input {
							Value = 1,
							Expression = "min(max((comp.RenderEnd - time + 1 - min(Title.OutFrames, 1)) / max(Title.OutFrames, 1), 0), 1)",
						},
						EaseIn = Input { Value = 1, Expression = "1 - (1 - Title.RevealIn) * (1 - Title.RevealIn) * (1 - Title.RevealIn)", },
						EaseOut = Input { Value = 1, Expression = "1 - (1 - Title.RevealOut) * (1 - Title.RevealOut) * (1 - Title.RevealOut)", },
						Ease = Input { Value = 1, Expression = "min(Title.EaseIn, Title.EaseOut)", },
						StartSeconds = Input { Value = 5, },
						FPS = Input { Value = 24, },
						Remain = Input {
							Value = 1,
							Expression = "min(max(1 - (time - comp.RenderStart) / max(Title.StartSeconds * Title.FPS, 1), 0), 1)",
						},
						PopIn = Input {
							Value = 1,
							Expression = "(1 + 2.70158 * (Title.RevealIn - 1) * (Title.RevealIn - 1) * (Title.RevealIn - 1) + 1.70158 * (Title.RevealIn - 1) * (Title.RevealIn - 1))",
						},
						PopOut = Input {
							Value = 1,
							Expression = "(1 + 2.70158 * (Title.RevealOut - 1) * (Title.RevealOut - 1) * (Title.RevealOut - 1) + 1.70158 * (Title.RevealOut - 1) * (Title.RevealOut - 1))",
						},
						Vis = Input { Value = 1, Expression = "max(Title.PopIn * Title.PopOut, 0)", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 }, },
					UserControls = ordered() {
						InFrames = {
							LINKS_Name = "Intro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 10,
							ICS_ControlPage = "Controls",
						},
						OutFrames = {
							LINKS_Name = "Outro Frames",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							INP_MinAllowed = 0,
							INP_Default = 10,
							ICS_ControlPage = "Controls",
						},
						RevealIn = {
							LINKS_Name = "Reveal In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						RevealOut = {
							LINKS_Name = "Reveal Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseIn = {
							LINKS_Name = "Ease In",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						EaseOut = {
							LINKS_Name = "Ease Out",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Ease = {
							LINKS_Name = "Ease",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						StartSeconds = {
							LINKS_Name = "Start Seconds",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_MinScale = 1,
							INP_MaxScale = 600,
							INP_MinAllowed = 0,
							INP_Default = 5,
							ICS_ControlPage = "Controls",
						},
						FPS = {
							LINKS_Name = "Frame Rate",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 1,
							INP_MaxScale = 120,
							INP_Default = 24,
							ICS_ControlPage = "Controls",
						},
						Remain = {
							LINKS_Name = "Remain",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						PopIn = {
							LINKS_Name = "PopIn",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						PopOut = {
							LINKS_Name = "PopOut",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
						Vis = {
							LINKS_Name = "Vis",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Default = 1,
							IC_Visible = false,
							ICS_ControlPage = "Controls",
						},
					},
				},
				Canvas = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, -66 }, },
				},
				BoxMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0.19, },
						Height = Input { Value = 0.075, },
						CornerRadius = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 }, },
				},
				Box = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.08, },
						TopLeftGreen = Input { Value = 0.08, },
						TopLeftBlue = Input { Value = 0.1, },
						TopLeftAlpha = Input { Value = 0.85, },
						EffectMask = Input { SourceOp = "BoxMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 }, },
				},
				TrackMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 0.5, 0.455 }, },
						Width = Input { Value = 0.14, },
						Height = Input { Value = 0.004, },
						CornerRadius = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 }, },
				},
				Track = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.35, },
						TopLeftGreen = Input { Value = 0.35, },
						TopLeftBlue = Input { Value = 0.38, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "TrackMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 }, },
				},
				BarMask = RectangleMask {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = 0, Expression = "Point(0.43 + 0.14 * Title.Remain / 2, 0.455)", },
						Width = Input { Value = 0, Expression = "0.14 * Title.Remain", },
						Height = Input { Value = 0.004, },
						CornerRadius = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 }, },
				},
				Bar = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.96, },
						TopLeftGreen = Input { Value = 0.7, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
						EffectMask = Input { SourceOp = "BarMask", Source = "Mask", },
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 }, },
				},
				Stack1 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Box", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 770, 66 }, },
				},
				Stack2 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack1", Source = "Output", },
						Foreground = Input { SourceOp = "Track", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 880, 66 }, },
				},
				Stack3 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack2", Source = "Output", },
						Foreground = Input { SourceOp = "Bar", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 990, 66 }, },
				},
				Stack4 = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Stack3", Source = "Output", },
						Foreground = Input { SourceOp = "Title", Source = "Output", },
						PerformDepthMerge = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 1100, 66 }, },
				},
				Place = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Bounce", Source = "Output", },
					},
					ViewInfo = OperatorInfo { Pos = { 1010, 132 }, },
				},
				Bounce = Transform {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Input = Input { SourceOp = "Stack4", Source = "Output", },
						Size = Input { Value = 1, Expression = "max(Title.PopIn * Title.PopOut, 0)", },
					},
					ViewInfo = OperatorInfo { Pos = { 900, 132 }, },
				},
			},
		},
	},
	ActiveTool = "LL_Countdown",
}
